class Solution:
    def largestOverlap(self, img1: List[List[int]], img2: List[List[int]]) -> int:
        maxCount=0;
        count=0;
        n=len(img1)
        for row_Offset in range(-(n - 1), n):
            for col_Offset in range(-(n - 1), n):
                count=self.overLap(img1,img2,row_Offset,col_Offset)
                maxCount=max(maxCount,count)

        return maxCount


    def overLap(self,A:List[List[int]], B: List[List[int]],row_Offset:int,col_Offset:int)->int:
        n=len(A)
        count=0
        for i in range(n):
            for j in range(n):

                _i = i + row_Offset
                _j = j + col_Offset

                if _i < 0 or _i >= n or _j < 0 or _j >= n:
                    continue

                if A[i][j] == 1 and B[_i][_j] == 1:
                    count += 1
    
        return count
