/*
Problem Description: Given two n x n binary matrices mat and target, return true if it is possible to make mat equal to target by rotating mat in 90-degree increments, or false otherwise.
Example 1:
Input: mat = [[0,1],[1,0]], target = [[1,0],[0,1]]
Output: true
Explanation: We can rotate mat 90 degrees clockwise to make mat equal target.
Example 2:
Input: mat = [[0,1],[1,1]], target = [[1,0],[0,1]]
Output: false
Explanation: It is impossible to make mat equal to target by rotating mat.
Example 3:
Input: mat = [[0,0,0],[0,1,0],[1,1,1]], target = [[1,1,1],[0,1,0],[0,0,0]]
Output: true
Explanation: We can rotate mat 90 degrees clockwise two times to make mat equal target.

Constraints:
n == mat.length == target.length
n == mat[i].length == target[i].length
1 <= n <= 10
mat[i][j] and target[i][j] are either 0 or 1.

*/
class Solution {
    public boolean findRotation(int[][] mat, int[][] target) 
    {
        int n=mat.length;
    
    //will do matrix rotation for 4 times, coz after 4 times it becomes the same matrix as original
        for(int r=0;r<=4;r++) //O(4)
        {
           //Now check if the current matrix is similar to target
           boolean isSimilar=true;
           for(int i=0;i<n;i++) //O(n^2)
           {
            for(int j=0;j<n;j++)
            {
               if(mat[i][j]!=target[i][j])
               {
                 isSimilar=false;
                 break;
               }
            }
            if(!isSimilar)
            {
                break;
            }
           }
           if(!isSimilar)
           {
             rotate(mat);
           }
           else
           {
             return true;
           }
    }

    return false;       
 }
    private void rotate(int[][] grid) //TC:O(n*n)
    {
        int n=grid.length;
       
        //Check for transpose
        for(int i=0;i<n;i++)
        {
         for(int j=i;j<n;j++)
        {
           // Do transpose
           int temp=grid[i][j];
           grid[i][j]=grid[j][i];
           grid[j][i]=temp;
        }
     }
     //Do reverse
     for(int i = 0; i < n; i++) {
            int left = 0, right = n - 1;
            while(left < right) {
                int temp = grid[i][left];
                grid[i][left] = grid[i][right];
                grid[i][right] = temp;
                left++;
                right--;
            }
     }

    }
}
//TC:O(n^2)
//SC:O(1)

       
        

/*
Approach: To rotate matrix 90 degree we need to do -> 1)Transpose & 2) Then reverse the row
Similarly to rotate matrix anti colockwise we need to do-> 1)Transpose & 2) Then reverse the col
