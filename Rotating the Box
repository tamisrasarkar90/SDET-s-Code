/*
Problem Description:You are given an m x n matrix of characters boxGrid representing a side-view of a box. Each cell of the box is one of the following:

A stone '#'
A stationary obstacle '*'
Empty '.'
The box is rotated 90 degrees clockwise, causing some of the stones to fall due to gravity. Each stone falls down until it lands on an obstacle, another stone, or the bottom of the box. Gravity does not affect the obstacles' positions, and the inertia from the box's rotation does not affect the stones' horizontal positions.

It is guaranteed that each stone in boxGrid rests on an obstacle, another stone, or the bottom of the box.

Return an n x m matrix representing the box after the rotation described above.

 

Example 1:



Input: boxGrid = [["#",".","#"]]
Output: [["."],
         ["#"],
         ["#"]]
Example 2:



Input: boxGrid = [["#",".","*","."],
              ["#","#","*","."]]
Output: [["#","."],
         ["#","#"],
         ["*","*"],
         [".","."]]
Example 3:



Input: boxGrid = [["#","#","*",".","*","."],
              ["#","#","#","*",".","."],
              ["#","#","#",".","#","."]]
Output: [[".","#","#"],
         [".","#","#"],
         ["#","#","*"],
         ["#","*","."],
         ["#",".","*"],
         ["#",".","."]]
 

Constraints:

m == boxGrid.length
n == boxGrid[i].length
1 <= m, n <= 500
boxGrid[i][j] is either '#', '*', or '.'.

*/
class Solution {
    public char[][] rotateTheBox(char[][] boxGrid) 
    {
        int m=boxGrid.length;
        int n=boxGrid[0].length;
        char[][] result=new char[n][m];
        //Step 1: Take transpose
        for(int i=0;i<n;i++)
        {
             for(int j=0;j<m;j++)
             {
                result[i][j]=boxGrid[j][i];
             }
        }
        //Step 2: Reverse the row
         for(int i=0;i<n;i++)
        {
           doReverse(result[i]);
        }
        //Step 3: Apply gravity-> For that if any cell contains " " replace it with # if nearby cell contains stone, if obstackle let it be
       /* for(int j=0;j<m;j++) //start with first col
        {
            for(int i=n-1;i>=0;i--) //and start from last row to check if empty space is there
            {
                if(result[i][j]=='.')
                {
                    int stoneRow=-1;
                    for(int k=i-1;k>=0;k--) //go check above row
                    {
                       if(result[k][j]=='*')
                       {
                         break;
                       }
                       else if(result[k][j]=='#')
                       {
                          stoneRow=k;
                          break;
                       }
                    }
                    if(stoneRow!=-1)
                    {
                        result[i][j]='#';
                        result[stoneRow][j]='.';
                    }
                }
            }
        }*/
        //Optimized apply gravity
      // Apply gravity
        // O(columns * rows)
        for (int j = 0; j < m; j++) {
            int spaceBottomRow = n - 1;
            for (int i = n - 1; i >= 0; i--) {
                if (result[i][j] == '*') {
                    spaceBottomRow = i - 1;
                    continue;
                }

                if (result[i][j] == '#') {
                    result[i][j] = '.';
                    result[spaceBottomRow][j] = '#';
                    spaceBottomRow--;
                }
            }
        }
      return result;
    }
    private static void doReverse(char[] grid)
    {
        int low=0;
        int high=grid.length-1;
        while(low<high)
        {
           char temp= grid[low];
           grid[low]=grid[high];
           grid[high]=temp;
           low++;
           high--;
        }
    }
}
//TC:O(m*m)*n)
