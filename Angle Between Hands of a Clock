/*
Problem Statement: Given two numbers, hour and minutes, return the smaller angle (in degrees) formed between the hour and the minute hand.
Answers within 10-5 of the actual value will be accepted as correct.
Example 1:
Input: hour = 12, minutes = 30
Output: 165
Example 2:
Input: hour = 3, minutes = 30
Output: 75
Example 3:
Input: hour = 3, minutes = 15
Output: 7.5
Constraints:
1 <= hour <= 12
0 <= minutes <= 59

*/
class Solution {
    public double angleClock(int hour, int minutes) 
    {
        double result=0;  
        double hoursAngle=(hour%12+(double)minutes/60)*30;
        double minsAngle=minutes*6;
        result=Math.abs(hoursAngle-minsAngle) ;
        return result>180?(360-result):result;
    }
}
/*
Approach: 1) There is total 360 angle now for hour angle=360/12=30
2)For minutes it is 360/60~ 6
3)For every given hours and mins=> hoursAngle= (hour+min/60)*30 , and minsAngle=mins*6
and then return abs(hoursAngle-minsAngle) return the min of angle that means result>180?(360-result):result;
*/
